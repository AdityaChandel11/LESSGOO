# Copy to .env for local development. In production, set these as service
# environment variables and store secrets in Secret Manager, never in a file.

# --- environment ---
ENVIRONMENT=development          # development | production

# --- database ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/phc
# Cloud SQL from Cloud Run (unix socket):
# DATABASE_URL=postgresql+asyncpg://APP_USER:PASSWORD@/phc?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- sessions ---
# Production refuses to start unless this is a random value of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_HOURS=12

# Salt for hashing health workers' phone numbers. Production refuses to start
# without it. Generate once and never rotate casually: changing it orphans
# every registered handset, and the only symptom is people being told their
# number is not registered.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HASH_SALT=

# --- demo affordances ---
# Production refuses to start with DEMO_MODE on unless ALLOW_PUBLIC_DEMO=true.
DEMO_MODE=true
ALLOW_PUBLIC_DEMO=false

# --- mode switches: these defaults need no credentials ---
LLM_MODE=mock                    # mock | live
MAPS_MODE=osm                    # osm  | google
COMMS_MODE=simulator             # simulator | live

# --- credentials, read only once the matching switch is flipped ---
GEMINI_API_KEY=
# Two separate Google keys, restricted differently (check both with
# `python -m scripts.check_maps`):
#   server key:  Routes API only; application restriction = none/IP; stays server-side
#   browser key: Map Tiles API only; restricted to your site's domains (HTTP referrers)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=
PUBLIC_WEBHOOK_BASE_URL=
BHASHINI_API_KEY=
REDIS_URL=

# --- frontend build (Vite only exposes VITE_-prefixed values) ---
# Leave empty: the site and API share one origin.
VITE_API_ORIGIN=
