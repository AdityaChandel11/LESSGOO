# Copy to .env for local development. In production, set these as service
# environment variables and store secrets in Secret Manager, never in a file.

# --- environment ---
ENVIRONMENT=development          # development | production

# --- database ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/phc
# Cloud SQL from Cloud Run (unix socket):
# DATABASE_URL=postgresql+asyncpg://APP_USER:PASSWORD@/phc?host=/cloudsql/PROJECT:REGION:INSTANCE
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- sessions ---
# Production refuses to start unless this is a random value of 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_HOURS=12

# --- phone registry ---
# Production refuses to start without this. It is what stops the contact
# registry from being turned back into a list of health workers' numbers, and
# changing it orphans every handset already registered:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PHONE_HASH_SALT=

# --- demo affordances ---
# Production refuses to start with DEMO_MODE on unless ALLOW_PUBLIC_DEMO=true.
DEMO_MODE=true
ALLOW_PUBLIC_DEMO=false

# --- mode switches: these defaults need no credentials ---
LLM_MODE=mock                    # mock | live
MAPS_MODE=osm                    # osm  | google
COMMS_MODE=simulator             # simulator | live
# burn_rate uses the last 28 days of readings and needs no model.
# federated uses the published forecasts, falling back to the burn rate
# whenever one is missing or older than FORECAST_MAX_AGE_DAYS.
FORECAST_MODE=burn_rate          # burn_rate | federated
FORECAST_MAX_AGE_DAYS=8

# --- credentials, read only once the matching switch is flipped ---
GEMINI_API_KEY=
# Two models on purpose. The free tier counts generate requests per day *per
# model*, so a day of ward photographs cannot exhaust the briefings, or the
# reverse. Not 3.6-flash: measured against a real key on 2026-09-23 it never
# answered, timing out at 158s, while these two answered in 10.1s and 2s.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Two separate Google keys, restricted differently (check both with
# `python -m scripts.check_maps`):
#   server key:  Routes API only; application restriction = none/IP; stays server-side
#   browser key: Map Tiles API only; restricted to your site's domains (HTTP referrers)
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=
PUBLIC_WEBHOOK_BASE_URL=
BHASHINI_API_KEY=

# --- local-only: the Federation page's "Run next round" ---
# The federation's own interpreter (backend/federation/.venv/bin/python).
# Blank keeps the button off; production never offers it.
FEDERATION_PYTHON=

# --- the deployed database, for scripts/remote.py only ---
# Render's External Database URL. Deliberately a separate name from
# DATABASE_URL: the seed truncates what it finds, so pointing one variable at
# both databases is how a local one gets destroyed.
RENDER_DATABASE_URL_EXTERNAL=

# --- serving the built site ---
# Set by the Dockerfile to /app/static. Must be an ABSOLUTE path: a relative
# one resolves against the process working directory, and the symptom is an
# API that answers while every page 404s.
# STATIC_DIR=/app/static

# --- frontend build (Vite only exposes VITE_-prefixed values) ---
# Leave empty: the site and API share one origin.
VITE_API_ORIGIN=
